resource "aws_lambda_function" "{{.Name}}" {
  function_name = "{{.Name}}"
  role          = {{or .RoleARN "\"arn:aws:iam::123456789012:role/lambda-role\""}}
  runtime       = "{{.runtime}}"
  memory_size   = {{or .memory "128"}}
  
  # Default placeholder for source code
  filename      = "lambda_function.zip"
  handler       = "index.handler"
}
